{
  "name": "character-creator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.tests.json --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "visuals": "pnpm build && tsx scripts/generate-task-002-visuals.ts",
    "validator": "pnpm build && node packages/asset-validator/dist/cli.js",
    "studio": "pnpm build && tsx scripts/build-studio.ts",
    "starter-pack": "pnpm build && tsx scripts/generate-starter-pack.ts && pnpm studio",
    "integration-example": "pnpm build && tsx scripts/build-vanilla-example.ts",
    "check:site-links": "tsx scripts/check-site-links.ts",
    "review-artifacts": "pnpm build && tsx scripts/generate-review-artifacts.ts",
    "release-audit": "pnpm build && tsx scripts/release-audit.ts",
    "validate": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "@types/node": "^26.3.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
