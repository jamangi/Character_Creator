{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://character-creator.dev/schemas/0.1.0/asset-pack.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "engine", "rigFamilies", "assets", "provenance"],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "version": { "$ref": "common.schema.json#/$defs/semver" },
    "engine": { "$ref": "common.schema.json#/$defs/semverRange" },
    "rigFamilies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/rigFamily" }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "manifest", "contentHash"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "manifest": { "$ref": "common.schema.json#/$defs/safePath" },
          "contentHash": { "$ref": "common.schema.json#/$defs/contentHash" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authors", "license", "source"],
      "properties": {
        "authors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "license": { "type": "string", "minLength": 1 },
        "source": { "type": ["string", "null"], "format": "uri-reference" }
      }
    },
    "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
  }
}

